      "CTI-DOC-001",
      {
        "documentId": "CTI-DOC-001",
        "title": "SYNTHETIC: APT29 Initial Infrastructure Incursion & PostgreSQL Exploitation",
        "source": "National Cyber Security Advisory Feed (Synthetic)",
        "sourceType": "REPORT",
        "publishedAt": "2026-08-11T09:31:35.390Z",
        "observedAt": "2026-08-09T09:31:35.390Z",
        "ingestedAt": "2026-09-28T09:31:35.391Z",
        "lastSeenAt": "2026-08-11T09:31:35.390Z",
        "confidence": 0.92,
        "sourceReliability": "HIGH",
        "classification": "INTERNAL",
        "contentHash": "hash-1790587895391-uq2jta",
        "status": "ACTIVE",
        "rawText": "[SYNTHETIC THREAT INTELLIGENCE ADVISORY - NOT A REAL EXPLOIT]\nThreat Actor: APT29 (also tracked as Cozy Bear, Midnight Blizzard)\nCampaign: Strategic Corporate Database Reconnaissance\nTechnique: T1190 (Exploit Public-Facing Application)\nVulnerability: CVE-2023-39417 (PostgreSQL SQL Injection & Dynamic Execution)\nTarget System: Computer 07 (Customer Database, running PostgreSQL on port 5432)\n\nSummary:\nIntelligence indicators confirm threat actor APT29 has actively utilized technique T1190 to exploit public-facing PostgreSQL interfaces. Incursion traces identify targeted SQL parameter tampering affecting Computer 07. The adversary bypasses input validation using dynamic SQL concatenation.",
        "extractedEntitiesCount": 5,
        "extractedRelationsCount": 3
      }
    ],
    [
      "CTI-DOC-002",
      {
        "documentId": "CTI-DOC-002",
        "title": "SYNTHETIC: Cross-Campaign Lateral Movement & Java Log4j Exploitation",
        "source": "Commercial SOC Incident Response Dispatch (Synthetic)",
